diff --git a/Makefile.in b/Makefile.in
index 5e477c7f..bd1173eb 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -1426,6 +1426,19 @@ $(DIST_COPY_TARGETS): | $(DST_DIR)
 
 all-dist: $(DIST_COPY_TARGETS)
 
+VRCRAFTER_PAYLOAD_DIR := $(SRCDIR)/vrcrafter/payload
+VRCRAFTER_DIST_DIR := $(DST_BASE)/vrcrafter/payload
+VRCRAFTER_NATIVE_PAYLOAD := winhttp.dll vrcrafter-winhttp-backend.dll
+VRCRAFTER_MANAGED_PAYLOAD := $(notdir $(wildcard $(VRCRAFTER_PAYLOAD_DIR)/managed/*.dll))
+VRCRAFTER_PAYLOAD_TARGETS := $(addprefix $(VRCRAFTER_DIST_DIR)/,$(VRCRAFTER_NATIVE_PAYLOAD)) \
+	$(addprefix $(VRCRAFTER_DIST_DIR)/managed/,$(VRCRAFTER_MANAGED_PAYLOAD))
+
+$(VRCRAFTER_DIST_DIR)/%: $(VRCRAFTER_PAYLOAD_DIR)/%
+	mkdir -p $(dir $@)
+	cp -a $< $@
+
+all-dist: $(VRCRAFTER_PAYLOAD_TARGETS)
+
 all-dist:
 	echo `date '+%s'` `GIT_DIR=$(abspath $(SRCDIR)/.git) git describe --tags` > $(DIST_VERSION)
 
