diff --git a/proton b/proton
index 977dc4ea..5f7244f3 100755
--- a/proton
+++ b/proton
@@ -992,6 +992,17 @@ class CompatData:
             if not file_exists(self.prefix_dir + "/dosdevices/z:", follow_symlinks=False):
                 os.symlink("/", self.prefix_dir + "/dosdevices/z:")
 
+            if g_session.vrcrafter_enabled:
+                makedirs(g_session.vrcrafter_log_dir)
+                system32 = self.prefix_dir + "/drive_c/windows/system32"
+                makedirs(system32)
+                for filename in ('winhttp.dll', 'vrcrafter-winhttp-backend.dll'):
+                    source = os.path.join(g_session.vrcrafter_payload_dir, filename)
+                    destination = os.path.join(system32, filename)
+                    temporary = destination + '.vrcrafter-new'
+                    shutil.copyfile(source, temporary)
+                    os.replace(temporary, destination)
+
             # collect configuration info
             steamdir = os.environ["STEAM_COMPAT_CLIENT_INSTALL_PATH"]
 
@@ -1482,6 +1493,18 @@ class Session:
                 "winebth.sys": "d", #disable winebth.sys as it crashes winedevice.exe
         }
 
+        self.vrcrafter_enabled = (
+                self.env.get('SteamGameId') == '1284190' and
+                self.env.get('VRCRAFTER_ENABLE') == '1')
+        self.vrcrafter_payload_dir = os.path.abspath(os.path.expanduser(
+                self.env.get('VRCRAFTER_PAYLOAD', '~/.local/share/vrcrafter/payload')))
+        self.vrcrafter_log_dir = os.path.abspath(os.path.expanduser(
+                self.env.get('VRCRAFTER_LOG_DIR', '~/.local/share/vrcrafter/logs')))
+        if self.vrcrafter_enabled:
+            self.dlloverrides['winhttp'] = 'n,b'
+            self.env['VRCRAFTER_PAYLOAD'] = 'Z:' + self.vrcrafter_payload_dir.replace('/', '\\')
+            self.env['VRCRAFTER_LOG_DIR'] = 'Z:' + self.vrcrafter_log_dir.replace('/', '\\')
+
         # CW Bug 21737. Locoland executable happens to be steam.exe.
         if os.environ.get("SteamGameId", 0) == "352130":
             del self.dlloverrides["steam.exe"]
